{
  "name": "react-kavia",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "cross-env BROWSER=none HOST=0.0.0.0 PORT=${PORT:-3000} react-scripts start",
    "build": "cross-env CI=false react-scripts build",
    "test": "cross-env CI=true react-scripts test --watchAll=false",
    "eject": "react-scripts eject",
    "healthcheck": "node -e \"require('http').get(process.env.HEALTH_URL||'http://localhost:3000',res=>{console.log('OK',res.statusCode);process.exit(0)}).on('error',()=>process.exit(1))\""
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
